# Host ports, published on 127.0.0.1 only. The bridge API has no authentication.
# Container ports stay 8080 (bridge) and 8000 (MCP).
BRIDGE_PORT=8080
MCP_PORT=8000

# Inside the containers these are fixed by docker-compose.yml:
# STORE_DIR=/data
# MESSAGES_DB_PATH=/data/messages.db
# WHATSAPP_API_BASE_URL=http://whatsapp-bridge:8080/api
# MCP_TRANSPORT=streamable-http

# From BotFather. The bot must be an admin of the private channel and allowed to post.
TELEGRAM_BOT_TOKEN=
# Numeric id of the private channel, for example -1001234567890. A @channel name also works.
TELEGRAM_CHANNEL_ID=
# Optional. Comma-separated Telegram user ids allowed to run the digest commands.
TELEGRAM_ALLOWED_USER_IDS=
# The digest agent. The bot calls POST /digests on this URL. No host port is published.
AGENT_URL=http://agent:8081

# Optional fallback until groups are ticked on the bridge page (http://127.0.0.1:8080/).
# After that save, allowed-groups.json on the store volume is the list that is used.
# Exact WhatsApp group names, or group JIDs ending in @g.us. Add further
# ALLOWED_GROUP_<number> lines as needed. Blank lines are ignored.
ALLOWED_GROUP_1=
ALLOWED_GROUP_2=
ALLOWED_GROUP_3=

# Local Whisper. Only the WhatsApp MCP calls it. Empty WHISPER_LANGUAGE auto-detects.
WHISPER_MCP_URL=http://whisper-mcp:8000/mcp
WHISPER_MODEL=small
WHISPER_LANGUAGE=
WHISPER_DEVICE=cpu

# DeepSeek writes the digest. The agent does not read messages.db itself.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Local midnight for resumen-diario, and that midnight seven days earlier for resumen-semanal.
DIGEST_TIMEZONE=Europe/Madrid
# Empty disables that job. Times are local to DIGEST_TIMEZONE. Weekly runs on Friday.
# A later start the same day still sends once. A missed Friday weekly is not sent on Saturday.
# A scheduled run posts only groups that had messages. A manual request includes the empty ones.
DIGEST_DAILY_AT=08:00
DIGEST_WEEKLY_AT=18:00
# Burst alert. 0 disables it. The bot stays quiet until a later check is back at or under the threshold.
MESSAGE_BURST_INTERVAL_MINUTES=15
MESSAGE_BURST_THRESHOLD=50
# Bridge health. The bot posts once when this is not "connected", then waits until it is connected again.
WHATSAPP_HEALTH_URL=http://whatsapp-bridge:8080/health
